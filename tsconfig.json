{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["db/**/*.ts", "netlify/functions/**/*.mts", "scripts/**/*.ts", "tests/**/*.ts", "drizzle.config.ts"]
}
